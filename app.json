{
  "expo": {
    "name": "Дневник тренировок",
    "slug": "training-diary",
    "scheme": "training-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.trainingdiary.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5A5AF0",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F8",
          "dark": {
            "backgroundColor": "#0D0D10"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "5be79c04-5d0c-4b51-bd54-c71f6f30441c"
      }
    },
    "icon": "./assets/icon.png"
  }
}
